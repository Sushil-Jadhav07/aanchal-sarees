# AANCHAL: Apache settings for the built site (copied into dist/ by `npm run build`).
# Upload the contents of dist/ (including this file) to the site's web root.
# Every block is wrapped in <IfModule>, so a server without that module simply ignores it.

# ---- Default page and no directory listing
DirectoryIndex index.html
Options -Indexes

# ---- Force HTTPS (a no-op on a local http server and behind proxies that already send HTTPS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ---- Types
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddDefaultCharset UTF-8
</IfModule>

# ---- Browser caching
# Vite gives its JS/CSS/fonts in /assets/ a hash in the filename, so those can be cached for a year.
# Images keep their names, so they get a month; the page itself is always re-checked.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # ---- Basic security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Unknown address: show the home page's 404 behaviour as a plain error (this is a one-page site)
ErrorDocument 404 /index.html

# ---- Never serve hidden or source-map files
<FilesMatch "^\.(?!well-known)|\.map$">
  Require all denied
</FilesMatch>
